# Copia este fichero como .streamlit/secrets.toml y rellena los valores
# En Streamlit Community Cloud, estos valores se ponen en "Secrets" desde la web
# NUNCA subas secrets.toml al repositorio (ya está en .gitignore)

# Cadena de conexión a Supabase (PostgreSQL)
# La obtienes en: Supabase → tu proyecto → Settings → Database → Connection string → URI
DATABASE_URL = "postgresql://postgres:[TU-PASSWORD]@db.[TU-PROYECTO].supabase.co:5432/postgres"
